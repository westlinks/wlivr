{
    "name": "westlinks/wlivr",
    "description": "WLIVR - Simple IVR package",
    "keywords": [
        "westlinks",
        "wlivr"
    ],
    "homepage": "https://github.com/westlinks/wlivr",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Westlinks Online",
            "email": "info@westlinks.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0 || ^8.1 || ^8.2 || ^8.3 || ^8.4",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0",
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Westlinks\\Wlivr\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Westlinks\\Wlivr\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Westlinks\\Wlivr\\WlivrServiceProvider"
            ],
            "aliases": {
                "Wlivr": "Westlinks\\Wlivr\\WlivrFacade"
            }
        }
    }
}
